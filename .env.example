# Copia este archivo como .env.local y llénalo (paso E6 de docs/guia-desarrollo.html).
# .env.local NUNCA se sube a Git. Este archivo sí, pero sin valores reales.

# --- Públicas: van dentro de la app (cualquiera puede verlas en el celular) ---
VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Secretas: solo para scripts de tu computadora (sin el prefijo VITE_) ---
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- Cuenta de administración que crea scripts/crear-admin.mjs ---
ADMIN_USUARIO=Admin
ADMIN_PASSWORD=
